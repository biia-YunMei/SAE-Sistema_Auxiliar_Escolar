# Copie para .env e preencha localmente. Nunca versione o arquivo .env.
AI_PROVIDER=gemini
AI_API_URL=https://generativelanguage.googleapis.com/v1beta/models
AI_MODEL=gemini-3.8-flash
AI_API_KEY=
# Opcional. Sem valor, o SAE procura instruções em instruções/AIconfig.md.
AI_INSTRUCTIONS_FILE=

# Chave da API escolar usada pelo worker de inbox/reply/ref/whoami.
ESCOLA_API_KEY=

# Demonstração: visitantes escolhem a turma para consultar tarefas e avisos.
# Sem cadastro e sem permissão para publicar. Fora da feira, mantenha 0.

# Obrigatória somente no primeiro cadastro; o SAE remove esta linha do .env
# assim que detectar usuários ou concluir a criação do primeiro coordenador.
SAE_BOOTSTRAP_KEY=

SERVER_PORT=8080
DATABASE_PATH=data/school.db
LOG_DIR=logs
LOG_LEVEL=INFO
SESSION_TIMEOUT_MIN=60
ESCOLA_CURSOR_PATH=data/escola_api.cursor
